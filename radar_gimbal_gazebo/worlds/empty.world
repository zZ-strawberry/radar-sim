<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <!-- 提供 /get_entity_state、/set_entity_state（gazebo_msgs），供外部节点移动模型 -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <update_rate>100.0</update_rate>
    </plugin>
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>
  </world>
</sdf>
